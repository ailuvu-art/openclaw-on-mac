# Copy to .env (./setup.sh does this for you). Never commit .env.

# Image: latest | latest-browser (bundled Chromium) | a pinned release tag
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

# Host port for the Control UI (bound to 127.0.0.1 only)
OPENCLAW_GATEWAY_PORT=18789

# Gateway auth token. Leave empty; ./setup.sh generates one.
OPENCLAW_GATEWAY_TOKEN=

# Container timezone (IANA name)
OPENCLAW_TZ=UTC

# Optional model provider keys (or add them during onboarding)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Optional channel tokens
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=

# --- Optional: pair this Mac as a node to a remote Gateway (./pair-node.sh) ---
# Node image; match the remote Gateway version, e.g. ghcr.io/openclaw/openclaw:2026.11.1
OPENCLAW_NODE_IMAGE=ghcr.io/openclaw/openclaw:latest
OPENCLAW_NODE_NAME=openclaw-on-mac
# Cloudflare Access service token, if the remote Gateway is behind Access
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
